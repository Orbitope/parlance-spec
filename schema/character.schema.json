{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "character.schema.json",
  "title": "Character / NPC",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/id"
    },
    "name": {
      "type": "string"
    },
    "archetype": {
      "type": "string",
      "description": "Project-defined grouping for this character — role, class, species, rank, whatever axis the project sorts its cast by. Free-form on purpose: the taxonomy is per-project, not a Parlance concept. Drives the editor's group-by-archetype view."
    },
    "factionId": {
      "$ref": "common.schema.json#/definitions/id"
    },
    "role": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dialogueStyle": {
      "type": "string",
      "description": "Notes on how they speak — vocabulary, cadence, tics."
    },
    "stats": {
      "type": "object",
      "description": "Optional NPC stats keyed by skill id (for opposed checks later).",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "portrait": {
      "$ref": "common.schema.json#/definitions/id",
      "description": "Portrait registry id (data/portraits.json), e.g. portrait_wren."
    },
    "loreRef": {
      "$ref": "common.schema.json#/definitions/loreRef"
    },
    "tags": {
      "$ref": "common.schema.json#/definitions/tags"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}
