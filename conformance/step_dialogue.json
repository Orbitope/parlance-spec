    "description": "node showIf FAILS: entry resolves through a two-skip chain to n_real; the skipped nodes' onEnter never appears — only the RESOLVED node's effects are returned",
    "dialogue": {
      "entry": "n_hidden",
      "id": "dlg_skip",
      "nodes": [
        {
          "id": "n_hidden",
          "next": "n_mid",
          "onEnter": [
            {
              "flag": "ghost",
              "type": "set_flag",
              "value": true
            }
          ],
          "showIf": {
            "flag": "cooperated",
            "type": "flag",
            "value": true
          },
          "text": "SECRET: gated line."
        },
        {
          "id": "n_mid",
          "next": "n_real",
          "showIf": {
            "flag": "cooperated",
            "type": "flag",
            "value": true
          },
          "text": "Second gated line."
        },
        {
          "choices": [
            {
              "goto": "n_hidden",
              "id": "c_go",
              "text": "Go."
            }
          ],
          "id": "n_real",
          "onEnter": [
            {
              "flag": "arrived",
              "type": "set_flag",
              "value": true
            }
          ],
          "text": "Shown line."
        }
      ]
    },
    "expected": {
      "nodeId": "n_real",
