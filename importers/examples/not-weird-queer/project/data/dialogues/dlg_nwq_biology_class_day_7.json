    },
    {
      "id": "n_nwq_biology_group_project_3",
      "next": "n_nwq_biology_group_project_4",
      "text": "$ally addresses $name by $pos correct pronouns and $bioteam gets confused. What should $name do?"
    },
    {
      "id": "n_nwq_biology_group_project_4",
      "next": "n_nwq_biology_group_project_5",
