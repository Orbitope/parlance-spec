        },
        {
          "id": "c_nwq_not_to_worry_about",
          "text": "not to worry about it"
        }
      ],
      "id": "n_nwq_biology_group_project_5",
      "isEnd": true,
      "text": "* Tell $bioteam"
    },
    {
      "id": "n_nwq_defend_gender_biology",
      "next": "n_nwq_defend_gender_biology_2",
      "text": "$name explains to $bioteam that $sbj prefers $sbj/$obj pronouns."
    },
    {
      "id": "n_nwq_defend_gender_biology_2",
      "next": "n_nwq_defend_gender_biology_3",
      "text": "{"
