    {
      "id": "n_episode2_gymnasium6_8",
      "next": "n_episode2_gymnasium6_9",
      "speakerId": "char_you",
      "text": "Je suis au courant de ce qui t’arrive. C’est grave, on devrait en parler. Ça a commencé comment ?"
