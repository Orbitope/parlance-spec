      "speakerId": "char_bryan",
      "text": "Salut, ça va ?"
    },
    {
      "choices": [
        {
          "effects": [
            {
              "counter": "score",
              "delta": 1,
              "type": "adjust_counter"
            }
          ],
          "goto": "n_episode2_sms4_3",
