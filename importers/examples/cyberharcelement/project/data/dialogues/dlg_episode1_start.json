      "id": "n_episode1_endneutral_5",
      "next": "n_episode1_endneutral_6",
      "speakerId": "char_cpe",
      "text": "Dois-je vous encore vous rappeler ce qu'encourent les auteurs ou complices au regard de la loi ?"
