          "variable": "time"
        }
      ],
      "speakerId": "char_narrator",
      "text": "La journée au collège débute avec le cours de mathématiques."
    },
    {
      "id": "n_episode1_class1_3",
      "next": "n_episode1_class1_4",
      "speakerId": "char_narrator",
      "text": "Ta professeure Madame Martin fait l’appel."
    },
    {
      "id": "n_episode1_class1_4",
      "next": "n_episode1_class1_5",
      "speakerId": "char_professor",
      "text": "Bonjour à toutes et à tous. Veuillez vous installer rapidement, s’il vous plaît."
    },
    {
      "id": "n_episode1_class1_5",
      "next": "n_episode1_class1_6",
      "speakerId": "char_professor",
      "text": "Béranger Clémence ?"
    },
    {
      "id": "n_episode1_class1_6",
      "next": "n_episode1_class1_7",
      "text": "Présente !"
    },
    {
      "id": "n_episode1_class1_7",
      "next": "n_episode1_class1_8",
      "speakerId": "char_professor",
      "text": "Bonnet Maxime ?"
    },
    {
      "id": "n_episode1_class1_8",
      "next": "n_episode1_class1_9",
      "text": "Présent !"
    },
    {
      "id": "n_episode1_class1_9",
      "next": "n_episode1_class1_10",
      "speakerId": "char_professor",
      "text": "Par rapport à Bouracha Hakim je souhaitais vous informer qu'il ne viendra plus en classe désormais."
    },
    {
      "id": "n_episode1_class1_10",
      "next": "n_episode1_class1_11",
      "speakerId": "char_professor",
      "text": "Si vous avez des questions je pourrais y répondre."
    },
    {
      "id": "n_episode1_class1_11",
      "next": "n_episode1_class1_12",
      "text": "Pourquoi ?"
    },
    {
      "id": "n_episode1_class1_12",
      "next": "n_episode1_class1_13",
      "text": "Il a quitté le collège ?"
    },
    {
      "id": "n_episode1_class1_13",
      "next": "n_episode1_class1_14",
      "text": "Il reviendra jamais du coup ?"
    },
    {
      "id": "n_episode1_class1_14",
      "next": "n_episode1_class1_15",
      "text": "Si c'est ça, dommage, il était cool."
    },
    {
      "id": "n_episode1_class1_15",
      "next": "n_episode1_class1_16",
      "text": "C'est pas comme si c'était grave."
    },
    {
      "id": "n_episode1_class1_16",
      "next": "n_episode1_class1_17",
      "text": "J’ai même pas pu lui dire au revoir."
    },
    {
      "id": "n_episode1_class1_17",
      "next": "n_episode1_class1_18",
      "text": "J'espère qu'il déménage !"
    },
    {
      "id": "n_episode1_class1_18",
      "next": "n_episode1_class1_19",
      "text": "Y’a bien une raison pour qu’il soit parti, non ?"
    },
    {
      "id": "n_episode1_class1_19",
      "next": "n_episode1_class1_20",
      "text": "Ah, pas sûr que ce soit une grande perte, c’était pas loin d’être le mec le plus inutile de la classe."
    },
    {
      "choices": [
        {
          "effects": [
            {
              "counter": "score",
              "delta": 1,
              "type": "adjust_counter"
            }
          ],
          "goto": "n_episode1_class1_21",
          "id": "c_episode1_vous_tes_qui_pour",
          "text": "\"Vous êtes qui pour le juger comme ça?\""
        },
        {
          "effects": [
            {
              "counter": "score",
              "delta": -1,
              "type": "adjust_counter"
            }
          ],
          "goto": "n_episode1_class1_23",
          "id": "c_episode1_tout_le_monde_l",
          "text": "\"Tout le monde l’a oublié\""
        },
        {
          "goto": "n_episode1_class1_24",
          "id": "c_episode1_ne_rien_dire",
          "text": "Ne rien dire"
        }
      ],
      "id": "n_episode1_class1_20",
      "text": "Haha ! Ouais il sera mieux dans un autre établissement avec d’autres fragiles comme lui."
    },
    {
      "id": "n_episode1_class1_21",
      "next": "n_episode1_class1_22",
      "speakerId": "char_you",
      "text": "Vous êtes qui pour le juger comme ça, vous lui avez jamais parlé."
    },
    {
      "id": "n_episode1_class1_22",
      "next": "n_episode1_class1_25",
      "speakerId": "char_you",
      "text": "Vous connaissez quoi de lui pour dire ça, sérieux?"
    },
    {
      "id": "n_episode1_class1_23",
      "next": "n_episode1_class1_25",
      "speakerId": "char_you",
      "text": "J’avoue que ça fait 3 semaines qu’il ne vient pas tout le monde l’a oublié."
    },
    {
      "id": "n_episode1_class1_24",
      "next": "n_episode1_class1_25",
      "speakerId": "char_you",
      "text": "..."
    },
    {
      "id": "n_episode1_class1_25",
      "next": "n_episode1_class1_26",
      "speakerId": "char_professor",
      "text": "Ça suffit !"
    },
    {
      "id": "n_episode1_class1_26",
      "next": "n_episode1_class1_27",
      "speakerId": "char_professor",
      "text": "Si vous souhaitez en parler, nous pouvons le faire, mais il faut bien s'écouter."
    },
    {
      "id": "n_episode1_class1_27",
      "next": "n_episode1_class1_28",
      "speakerId": "char_professor",
      "text": "Maintenant, je vous demande de prêter toute votre attention à M Douraud, qui souhaite vous parler d’un sujet important : le cyberharcèlement."
    },
    {
      "id": "n_episode1_class1_28",
      "next": "n_episode1_class1_29",
      "onEnter": [
        {
          "type": "set_text",
          "value": "Lundi 13 Novembre, 08h50",
          "variable": "time"
        }
      ],
      "speakerId": "char_cpe",
      "text": "Bonjour à tous. Si j’interviens ce matin, c’est pour vous parler d'un sujet qui nous préoccupe avec l'équipe enseignante."
    },
    {
      "id": "n_episode1_class1_29",
      "next": "n_episode1_class1_30",
      "speakerId": "char_cpe",
      "text": "Il s'agit du cyberharcèlement."
    },
    {
      "id": "n_episode1_class1_30",
      "next": "n_episode1_class1_31",
      "speakerId": "char_cpe",
      "text": "Je rappelle à chacun que harceler quelqu'un, même via les réseaux, est strictement interdit. Si c'est avéré, cela constitue un délit, passible d'une peine de prison et de fortes amendes."
    },
    {
      "id": "n_episode1_class1_31",
      "next": "n_episode1_class1questions",
      "speakerId": "char_cpe",
      "text": "De même, le simple fait de relayer ce type de contenu est condamnable au regard de la loi."
    },
    {
      "id": "n_episode1_class1questions",
      "next": "n_episode1_class1questions_2",
      "text": "SKIP"
    },
    {
      "choices": [
        {
          "goto": "n_episode1_class1questions_3",
          "id": "c_episode1_que_faire_si_on",
          "text": "Que faire si on se fait harceler sur les réseaux sociaux ?"
        },
        {
          "goto": "n_episode1_class1questions_9",
          "id": "c_episode1_que_faire_si_on_2",
          "text": "Que faire si on est témoin de cyberharcèlement ?"
        },
        {
          "goto": "n_episode1_class1questions_14",
          "id": "c_episode1_non",
          "text": "Non"
        }
      ],
      "id": "n_episode1_class1questions_2",
      "speakerId": "char_cpe",
      "text": "Avez-vous des questions ?"
    },
    {
      "id": "n_episode1_class1questions_3",
      "next": "n_episode1_class1questions_4",
      "speakerId": "char_you",
      "text": "Que faire si on se fait harceler sur les réseaux sociaux ?"
    },
    {
      "id": "n_episode1_class1questions_4",
      "next": "n_episode1_class1questions_5",
      "speakerId": "char_cpe",
      "text": "Si vous en êtes victime, sachez qu'en parler est votre meilleure défense."
    },
    {
      "id": "n_episode1_class1questions_5",
      "next": "n_episode1_class1questions_6",
      "speakerId": "char_cpe",
      "text": "Vous pouvez le faire auprès de vos amis, de vos proches comme la famille, d’associations spécialisées comme e-enfance à appeler au 3018, de vos professeurs ou de moi-même."
    },
    {
      "id": "n_episode1_class1questions_6",
      "next": "n_episode1_class1questions_7",
      "speakerId": "char_cpe",
      "text": "Nous serons toujours là pour vous écouter."
    },
    {
      "id": "n_episode1_class1questions_7",
      "next": "n_episode1_class1questions_8",
      "speakerId": "char_cpe",
      "text": "Mais vous pouvez également le faire en vous rendant auprès de la gendarmerie ou du commissariat, ou pour plus de discrétion, par téléphone ou chat dédié."
    },
    {
      "id": "n_episode1_class1questions_8",
      "next": "n_episode1_class1questions",
      "speakerId": "char_cpe",
      "text": "Dans tous les cas, ne restez pas dans le silence, c'est très important."
    },
    {
      "id": "n_episode1_class1questions_9",
      "next": "n_episode1_class1questions_10",
      "speakerId": "char_you",
      "text": "Que faire si on est témoin de cyberharcèlement ?"
    },
    {
      "id": "n_episode1_class1questions_10",
      "next": "n_episode1_class1questions_11",
      "speakerId": "char_cpe",
      "text": "Maintenant, si vous en êtes témoin, vous pouvez agir afin d'aider une personne victime de cyberharcèlement."
    },
    {
      "id": "n_episode1_class1questions_11",
      "next": "n_episode1_class1questions_12",
      "speakerId": "char_cpe",
      "text": "Il est aussi possible de contacter les services de police ou de gendarmerie : Vous pourrez témoigner, collecter des preuves sous forme de capture d'écran, d'enregistrement audio ou vidéo."
    },
    {
      "id": "n_episode1_class1questions_12",
      "next": "n_episode1_class1questions_13",
      "speakerId": "char_cpe",
      "text": "Les preuves sont essentielles aux services de justice. Mais en aucun cas vous ne devez publier ces preuves sur Internet."
    },
    {
      "id": "n_episode1_class1questions_13",
      "next": "n_episode1_class1questions",
      "speakerId": "char_cpe",
      "text": "Vous pouvez les conserver dans le coffre fort de l'application 3018."
    },
    {
      "id": "n_episode1_class1questions_14",
      "next": "n_episode1_preoutside1",
      "speakerId": "char_cpe",
      "text": "Je ne vais pas perturber votre cours plus longtemps. Merci de votre attention."
    },
    {
      "id": "n_episode1_preoutside1",
      "next": "n_episode1_preoutside1_2",
      "text": "La sonnerie retentit, tout le monde sort pour la pause."
    },
    {
      "id": "n_episode1_preoutside1_2",
      "next": "n_episode1_outside1",
      "text": "Dans la cour, plusieurs groupes d’élèves discutent de l’intervention du CPE."
    },
    {
      "choices": [
        {
          "effects": [
            {
              "counter": "listenedconversations",
