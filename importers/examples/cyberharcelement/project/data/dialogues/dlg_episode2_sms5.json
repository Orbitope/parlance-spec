  "nodes": [
    {
      "id": "n_episode2_sms5",
      "next": "n_episode2_sms5_2",
      "speakerId": "char_alex",
      "text": "Salut, ça va ?"
    },
    {
      "id": "n_episode2_sms5_2",
      "next": "n_episode2_sms5_3",
      "speakerId": "char_you",
      "text": "Hey ! Ça va et toi ? Ça fait longtemps !"
    },
    {
      "id": "n_episode2_sms5_3",
      "next": "n_episode2_sms5_4",
      "speakerId": "char_alex",
      "text": "Super ! Oui ça fait trop longtemps ! D’ailleurs ça te tente de faire une sortie samedi dans l’aprem ?"
    },
    {
      "id": "n_episode2_sms5_4",
      "next": "n_episode2_sms5_5",
      "speakerId": "char_you",
      "text": "Carrément ! Je proposerai à Liam aussi, ça sera mieux à trois, qu’est-ce que t’en dis ?"
    },
    {
      "id": "n_episode2_sms5_5",
      "next": "n_episode2_sms5_6",
      "speakerId": "char_alex",
      "text": "Ah ouais... Euh... En fait, j’aimerais autant éviter qu’on me voie avec lui pour être honnête. Je savais pas que tu traînais encore avec lui..."
    },
    {
      "id": "n_episode2_sms5_6",
      "next": "n_episode2_sms5_7",
      "speakerId": "char_you",
      "text": "Ah bon mais pourquoi ça ? On fait toujours du handball ensemble donc on est toujours soudés ! On est une équipe."
    },
    {
      "id": "n_episode2_sms5_7",
      "next": "n_episode2_sms5_8",
      "speakerId": "char_alex",
      "text": "Ah ouais, j’avais oublié. Mais si j’étais toi j’éviterais de traîner avec lui en public."
    },
    {
      "id": "n_episode2_sms5_8",
      "next": "n_episode2_sms5_9",
      "speakerId": "char_you",
      "text": "Mais c’est quoi le problème à la fin ?!"
    },
    {
      "choices": [
        {
          "effects": [
            {
              "counter": "score",
              "delta": 1,
              "type": "adjust_counter"
            }
          ],
          "goto": "n_episode2_sms5_10",
          "id": "c_episode2_et_est_ce_que",
          "text": "Et est-ce que tu as des preuves ?"
        },
        {
          "goto": "n_episode2_sms5_12",
          "id": "c_episode2_euh_ok",
          "text": "Euh, ok..."
        },
        {
          "effects": [
            {
              "counter": "score",
