              "type": "adjust_counter"
            }
          ],
          "goto": "n_episode2_sms5_14",
          "id": "c_episode2_non_s_rieux_envoie",
          "text": "Non sérieux ?! Envoie plus d’infos !"
        }
      ],
      "id": "n_episode2_sms5_9",
      "speakerId": "char_alex",
      "text": "Bah... Tu sais bien, il a essayé d’embrasser son pote Ben. Il s’est fait recaler mais ça reste dégueu !"
    },
    {
      "id": "n_episode2_sms5_10",
      "next": "n_episode2_sms5_11",
      "speakerId": "char_you",
      "text": "Et est-ce tu as des preuves de tout ça avant de t’emballer dans des rumeurs et théories folles ?"
    },
    {
      "id": "n_episode2_sms5_11",
      "next": "n_episode2_sms5_17",
      "speakerId": "char_alex",
      "text": "Dans tous les cas, il y a une lettre d’amour que Liam a écrite à Ben qui circule !"
    },
    {
      "id": "n_episode2_sms5_12",
      "next": "n_episode2_sms5_13",
      "speakerId": "char_you",
      "text": "Euh, ok… Je sais pas trop quoi faire de cette info..."
    },
    {
      "id": "n_episode2_sms5_13",
      "next": "n_episode2_sms5_17",
      "speakerId": "char_alex",
      "text": "J’te mets au courant, c’est tout. Tu peux pas faire comme si tu savais pas maintenant !"
    },
    {
      "id": "n_episode2_sms5_14",
      "next": "n_episode2_sms5_15",
      "speakerId": "char_you",
      "text": "Non sérieux ?! Envoie plus d’infos !"
    },
    {
      "id": "n_episode2_sms5_15",
      "next": "n_episode2_sms5_16",
      "speakerId": "char_alex",
      "text": "Alors, maintenant la moitié du collège est au courant. Y’a même une lettre d’amour qui circule sur Insta !"
    },
    {
      "id": "n_episode2_sms5_16",
      "next": "n_episode2_sms5_17",
      "speakerId": "char_alex",
      "text": "Sérieux, c’est trop la honte d’écrire une lettre d’amour ! Ah ah !"
