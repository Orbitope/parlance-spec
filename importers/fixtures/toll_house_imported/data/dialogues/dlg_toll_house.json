          "id": "c_refuse",
          "text": "Refuse it"
        }
      ],
      "id": "n_bench",
      "text": "There is bread, if you want it. It is yesterday's."
    },
    {
      "id": "n_take",
      "next": "n_end_1",
      "text": "Good. It goes stale either way."
    },
    {
      "id": "n_refuse",
      "next": "n_end_1",
      "text": "Suit yourself."
    },
    {
