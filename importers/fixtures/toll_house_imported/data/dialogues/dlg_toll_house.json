{
  "entry": "n_start",
  "id": "dlg_toll_house",
  "nodes": [
    {
      "id": "n_start",
      "next": "n_start2",
      "text": "You are late on the road, and the gate is shut until light."
    },
    {
      "choices": [
        {
          "effects": [
            {
              "flag": "asked_gate",
              "type": "set_flag",
              "value": true
            }
          ],
          "goto": "n_gate",
          "id": "c_gate",
          "text": "Ask why the gate shuts at all"
        },
        {
          "goto": "n_fire",
          "id": "c_fire",
          "text": "Ask about the fire"
        },
        {
          "effects": [
            {
              "flag": "stayed_quiet",
              "type": "set_flag",
              "value": true
            }
          ],
          "goto": "n_bench",
          "id": "c_quiet",
          "text": "Say nothing and sit"
        }
      ],
      "id": "n_start2",
      "text": "I can offer a bench and a fire, and nothing better."
    },
    {
      "id": "n_gate",
      "next": "n_bench",
      "text": "Because the ford runs high, and the ford has taken people."
    },
    {
      "id": "n_fire",
      "next": "n_bench",
      "text": "It is a fire. It has no history worth the telling."
    },
    {
      "choices": [
        {
